{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": "data/build/dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/client/avatar/**",
    "src/client/features/assistant-*.ts",
    "src/client/features/global-voice-assistant.ts",
    "src/client/features/voice-*.ts",
    "src/client/global-voice-runtime-registry.ts",
    "src/client/assistant-settings-styles.ts",
    "src/client/locales/assistant*.ts",
    "src/client/locales/voiceModels.ts",
    "src/client/moss-voice-output.ts",
    "src/client/sherpa-voice-adapter.ts",
    "src/client/streaming-sentence-queue.ts",
    "src/client/voice-*.ts",
    "src/host/avatar/**",
    "src/host/desktop-assistant/**",
    "src/host/features/assistant-*.ts",
    "src/host/features/global-voice-*.ts",
    "src/host/features/moss-tts-worker.ts",
    "src/host/features/sherpa-*.ts",
    "src/host/features/voice-*.ts",
    "src/host/voice-diagnostics.ts",
    "src/shared/assistant-avatar*.ts",
    "src/shared/assistant-commands.ts",
    "src/shared/assistant-lifecycle.ts",
    "src/shared/assistant-message-timeline.ts",
    "src/shared/assistant-notification*.ts",
    "src/shared/assistant-prompts.ts",
    "src/shared/assistant-session-messages.ts",
    "src/shared/assistant-tts.ts",
    "src/shared/assistant-voice-sessions.ts",
    "src/shared/desktop-assistant.ts",
    "src/shared/voice-diagnostics.ts",
    "src/shared/voice-initialization.ts",
    "src/shared/voice-models.ts",
    "src/shared/voice-stream.ts",
    "src/shared/voice-text.ts",
    "src/shared/contracts/voice-runtime.ts",
    "src/dsh-capabilities/client/assistant-session-navigation-adapter.ts",
    "src/dsh-capabilities/host/assistant-agent-adapter.ts",
    "src/dsh-capabilities/host/assistant-web-search-adapter.ts",
    "src/typert.notifications-client.ts"
  ]
}
