{
  "name": "dsh-codingns",
  "version": "0.1.0",
  "description": "CodingNS 的 DeepSeek Harness 插件骨架与连接契约",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./client/lan-access": {
      "types": "./dist/client/lan-access.d.ts",
      "default": "./dist/client/lan-access.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap/index.d.ts",
      "default": "./dist/bootstrap/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    },
    "./features": {
      "types": "./dist/features/index.d.ts",
      "default": "./dist/features/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "default": "./dist/transport/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": "0.1.6-alpha.2",
    "node": ">=22.19.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./dsh.bundle.patch"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run bundle:client",
    "bundle:client": "tsdown",
    "dev:link": "node scripts/link-dsh-dev.mjs",
    "dev:watch": "node scripts/dev-watch.mjs",
    "watch:client": "tsdown --watch",
    "test": "pnpm run build && node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dsh.bundle.patch",
    "profile/**",
    "README.md",
    "package.json"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.1.6-alpha.2",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
