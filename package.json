{
  "name": "dsh-codingns",
  "version": "0.1.1",
  "description": "DSH-CodingNS 的 DeepSeek Harness 插件骨架与连接契约",
  "type": "module",
  "main": "./data/build/dist/index.js",
  "types": "./data/build/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./data/build/dist/index.d.ts",
      "default": "./data/build/dist/index.js"
    },
    "./host": {
      "types": "./data/build/dist/host/index.d.ts",
      "default": "./data/build/dist/host/index.js"
    },
    "./typert": {
      "types": "./data/build/dist/typert.host.d.ts",
      "default": "./data/build/dist/typert.host.js"
    },
    "./client": {
      "types": "./data/build/dist/client/index.d.ts",
      "default": "./data/build/dist/client/bundle.js"
    },
    "./client/lan-access": {
      "types": "./data/build/dist/client/lan-access.d.ts",
      "default": "./data/build/dist/client/lan-access.js"
    },
    "./bootstrap": {
      "types": "./data/build/dist/bootstrap/index.d.ts",
      "default": "./data/build/dist/bootstrap/index.js"
    },
    "./shared": {
      "types": "./data/build/dist/shared/index.d.ts",
      "default": "./data/build/dist/shared/index.js"
    },
    "./features": {
      "types": "./data/build/dist/features/index.d.ts",
      "default": "./data/build/dist/features/index.js"
    },
    "./transport": {
      "types": "./data/build/dist/transport/index.d.ts",
      "default": "./data/build/dist/transport/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.1.5-rc.3 <0.1.8-0",
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.5-rc.3 <0.1.8-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./dsh.bundle.patch"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "preinstall": "node scripts/check-dsh-install.mjs",
    "version:check": "node scripts/check-version-sync.mjs",
    "capability:check": "node scripts/check-capability-retirement.mjs",
    "capability:report": "node scripts/generate-capability-report.mjs",
    "version:set-plugin": "node scripts/set-plugin-version.mjs",
    "version:set-dsh": "node scripts/set-dsh-version.mjs",
    "prebuild": "pnpm run version:check",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && pnpm run bundle:client && pnpm run bundle:h5",
    "prepack": "pnpm run build",
    "publish:local": "bash scripts/publish-npm-package.sh",
    "bundle:client": "tsdown",
    "bundle:h5": "tsdown --config tsdown.h5.config.ts",
    "dev:link": "node scripts/link-dsh-dev.mjs",
    "dev:watch": "node scripts/dev-watch.mjs",
    "watch:client": "tsdown --watch",
    "test": "pnpm run build && node --test tests/*.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "data/build/dist/**/*.js",
    "data/build/dist/**/*.d.ts",
    "assets/provider-icons/**",
    "dsh.bundle.patch",
    "profile/**",
    "version.json",
    "README.md",
    "package.json",
    "scripts/check-dsh-install.mjs"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.6-alpha.2",
    "@types/react": "~18.3.1",
    "@types/ws": "^8.18.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-remotes": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.6-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@lydell/node-pty": "1.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "werift": "^0.24.4",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  }
}
