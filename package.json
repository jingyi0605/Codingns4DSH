{
  "name": "@jingyi0605/codingns4dsh",
  "version": "0.2.1-beta.2",
  "description": "Codingns4DSH 插件骨架与连接契约",
  "repository": {
    "type": "git",
    "url": "https://github.com/jingyi0605/Codingns4DSH"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./data/build/dist/index.js",
  "types": "./data/build/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./data/build/dist/index.d.ts",
      "default": "./data/build/dist/index.js"
    },
    "./host": {
      "types": "./data/build/dist/host/index.d.ts",
      "default": "./data/build/dist/host/index.js"
    },
    "./typert": {
      "types": "./data/build/dist/typert.host.d.ts",
      "default": "./data/build/dist/typert.host.js"
    },
    "./remote": {
      "types": "./data/build/dist/typert.remote-client.d.ts",
      "default": "./data/build/dist/typert.remote-client.js"
    },
    "./client": {
      "types": "./data/build/dist/client/index.d.ts",
      "default": "./data/build/dist/client/bundle.js"
    },
    "./client/lan-access": {
      "types": "./data/build/dist/client/lan-access.d.ts",
      "default": "./data/build/dist/client/lan-access.js"
    },
    "./bootstrap": {
      "types": "./data/build/dist/bootstrap/index.d.ts",
      "default": "./data/build/dist/bootstrap/index.js"
    },
    "./shared": {
      "types": "./data/build/dist/shared/index.d.ts",
      "default": "./data/build/dist/shared/index.js"
    },
    "./features": {
      "types": "./data/build/dist/features/index.d.ts",
      "default": "./data/build/dist/features/index.js"
    },
    "./transport": {
      "types": "./data/build/dist/transport/index.d.ts",
      "default": "./data/build/dist/transport/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <=0.2.1-alpha.1",
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <=0.2.1-alpha.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./dsh.bundle.patch"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-user-questions",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "check:dsh-install": "node scripts/check-dsh-install.mjs",
    "check:dsh-matrix": "node scripts/check-dsh-matrix.mjs",
    "replay:dsh-install": "node scripts/replay-dsh-install.mjs",
    "version:check": "node scripts/check-version-sync.mjs",
    "capability:check": "node scripts/check-capability-retirement.mjs",
    "capability:report": "node scripts/generate-capability-report.mjs",
    "i18n:check": "node scripts/check-client-i18n.mjs",
    "i18n:report": "node scripts/check-client-i18n.mjs --warn-only",
    "version:set-plugin": "node scripts/set-plugin-version.mjs",
    "version:set-dsh": "node scripts/set-dsh-version.mjs",
    "prebuild": "pnpm run version:check",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && pnpm run bundle:client && pnpm run bundle:h5",
    "prepack": "pnpm run build",
    "publish:local": "bash scripts/publish-npm-package.sh",
    "bundle:client": "tsdown",
    "bundle:h5": "tsdown --config tsdown.h5.config.ts",
    "dev:link": "node scripts/link-dsh-dev.mjs",
    "dev:watch": "node scripts/dev-watch.mjs",
    "dsh:web": "bash scripts/run-dsh-web.sh",
    "dsh:stage0": "bash scripts/run-dsh-stage0.sh",
    "dsh:stage0:clean-link": "bash scripts/clean-stage0-dev-link.sh",
    "watch:client": "tsdown --watch",
    "test": "pnpm run build && node --import ./tests/register-css-loader.mjs --test tests/*.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "data/build/dist/**/*.js",
    "data/build/dist/**/*.d.ts",
    "data/build/dist/**/*.js.map",
    "data/build/dist/**/*.d.ts.map",
    "assets/provider-icons/**",
    "dsh.bundle.patch",
    "profile/**",
    "version.json",
    "README.md",
    "package.json",
    "scripts/check-dsh-install.mjs"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cordis-plugin-include": "~1.0.9",
    "@deepseek-ai/cordis-plugin-group": "~1.0.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-alpha.1",
    "@shikijs/langs": "^4.3.1",
    "@types/mdast": "^4.0.4",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "anser": "^2.3.5",
    "diff": "^9.0.0",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shiki": "^4.3.1",
    "simple-icons": "16.31.0",
    "zustand": "~4.4.7",
    "immer": "^10.1.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@lydell/node-pty": "1.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.0.0",
    "codemirror": "^6.0.2",
    "werift": "^0.24.4",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "1.13.8"
  }
}
